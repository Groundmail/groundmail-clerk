{
  "name": "groundmail-clerk",
  "version": "0.15.24",
  "description": "Deliver Clerk email.created webhooks through Groundmail",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Groundmail/groundmail-clerk.git"
  },
  "homepage": "https://docs.groundmail.dev/guides/clerk",
  "bugs": {
    "url": "https://github.com/Groundmail/groundmail-clerk/issues"
  },
  "keywords": [
    "clerk",
    "clerk-auth",
    "email",
    "webhook",
    "transactional",
    "groundmail",
    "authentication"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "groundmail": ">=0.13.0"
  },
  "devDependencies": {
    "groundmail": "0.53.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
